    "tags": ["Agriculture", "Engineering", "Education", "Electronic Engineering"]
  },
  "timeline": {
    "title": "Growth Timeline",
    "items": [
      {
        "side": "right",
        "year": "1976",
        "text": "The university started with four faculties, 9,500 students, 214 faculty members, and 372 assistants."
      },
      {
        "side": "left",
        "year": "1975-1976",
        "title": "New Faculties",
        "text": "New faculties were added:",
        "tags": ["Science", "Commerce", "Medicine"]
      },
      {
        "side": "right",
        "year": "1987-1990",
        "title": "Expansion",
        "text": "The university expanded with more faculties:",
        "tags": ["Law", "Arts", "Nursing", "Home Economics"],
        "extraText": "The Liver Institute later became the National Liver Institute."
      },
      {
        "side": "left",
        "year": "1990s",
        "text": "The university expanded to Sadat City:",
        "tags": ["Physical Education", "Tourism", "Veterinary Medicine"],
        "extraText": "Genetic Engineering and Environmental Studies institutes were added."
      },
      {
        "side": "right",
        "year": "2003-2013",
        "text": "Computers and Information was established. In 2013, Sadat branch became an independent university."
      },
      {
        "side": "left",
        "year": "2015-2019",
        "title": "New Faculties",
        "list": [
