    "title": "発展の歩み",
    "items": [
      {
        "side": "right",
        "year": "1976",
        "text": "大学は4学部、9,500人の学生、214人の教員、372人の助手で始まりました。"
      },
      {
        "side": "left",
        "year": "1975-1976",
        "title": "新学部",
        "text": "新しい学部が追加されました:",
        "tags": ["理学", "商学", "医学"]
      },
      {
        "side": "right",
        "year": "1987-1990",
        "title": "拡大",
        "text": "大学はさらに拡大しました:",
        "tags": ["法学", "文学", "看護", "家政学"],
        "extraText": "肝臓研究所は後に国立肝臓研究所となりました。"
      },
      {
        "side": "left",
        "year": "1990年代",
        "text": "大学はサダト市へ拡大しました:",
        "tags": ["体育", "観光", "獣医学"],
        "extraText": "遺伝子工学と環境研究の研究所も追加されました。"
      },
      {
        "side": "right",
        "year": "2003-2013",
        "text": "情報学部が設立され、2013年にサダト支部は独立大学になりました。"
      },
      {
        "side": "left",
        "year": "2015-2019",
        "title": "新学部",
        "list": [
          "体育と応用健康科学が設立されました。",
          "獣医学部が2015年に設立されました。",
          "薬学部が2016/2019年に設立されました。",
          "幼児教育が学部になりました。",
          "メディア学部が2018年に設立されました。",
          "歯学部が2017年に設立されました。"
        ]
      },
      {
        "side": "right",
        "year": "未来",
        "text": "大学は社会と労働市場の需要に応じて新しい学部を設立し続けます。"
      }
    ]
