"universityHistory": {
  "heroTitle": "Establishment of Menoufia University",
  "imageAlt": "Menoufia University",
  "intro": {
    "title": "University Overview",
    "paragraphs": [
      "Menoufia University was established by Law No. 93 in August 1976, with its headquarters in Shebin El-Kom, to meet the growing demand for higher education and support community development.",
      "At the beginning, the university included faculties previously affiliated with Tanta University in Shebin El-Kom and Menouf. It started with four faculties:"
    ],
    "tags": ["Faculty of Agriculture", "Faculty of Engineering", "Faculty of Education", "Faculty of Electronic Engineering"]
  },
  "timeline": {
    "title": "Growth Timeline",
    "items": [
      {
        "side": "right",
        "year": "1976",
        "text": "The university was established in 1976 with four faculties, 9,500 undergraduate students, 214 faculty members, and 372 assistant staff."
      },
      {
        "side": "left",
        "year": "1975-1976",
        "title": "New Faculties",
        "text": "New faculties were added to meet growing educational needs:",
        "tags": ["Science", "Commerce", "Medicine"]
      },
      {
        "side": "right",
        "year": "1987-1990",
        "title": "Expansion",
        "text": "The university continued expanding with new faculties:",
        "tags": ["Law", "Arts", "Nursing", "Home Economics"],
        "extraText": "The Liver Institute was also developed and later became the National Liver Institute."
      },
      {
        "side": "left",
        "year": "1990s",
        "text": "The university expanded to Sadat City and added new faculties and institutes:",
        "tags": ["Physical Education", "Tourism & Hotels", "Veterinary Medicine"],
        "extraText": "Genetic Engineering and Environmental Studies institutes were also added."
      },
      {
        "side": "right",
        "year": "2003-2013",
        "text": "The Faculty of Computers and Information was established, followed by branches in Sadat City. In 2013, the Sadat branch became an independent university."
      },
      {
        "side": "left",
        "year": "2015-2019",
        "title": "New Faculties",
        "list": [
          "Physical Education and Applied Health Sciences were established in Shebin El-Kom.",
          "Faculty of Veterinary Medicine was established in 2015.",
          "Faculty of Pharmacy was established in 2016/2019.",
          "Kindergarten Department became the Faculty of Early Childhood Education.",
          "Faculty of Mass Communication was established in 2018.",
          "Faculty of Dentistry was established in 2017."
        ]
      },
      {
        "side": "right",
        "year": "Future",
        "text": "The university continues its strategy to establish new faculties and institutes that meet society and labor market needs."
      }
    ]
  }
}
